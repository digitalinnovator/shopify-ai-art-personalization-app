{
  "name": "@aiart/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-only engine: config, database, storage, images, security, templates, providers, queue and services.",
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "storage:init": "node --import tsx scripts/init-storage.ts"
  },
  "dependencies": {
    "@aiart/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1130.0",
    "@aws-sdk/s3-request-presigner": "3.1130.0",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@shopify/shopify-api": "14.0.1",
    "drizzle-kit": "0.31.10"
  }
}
