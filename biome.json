{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.react-router",
      "!**/drizzle/meta",
      "!**/extensions/**/assets",
      "!**/reports",
      "!**/test-results",
      "!**/playwright-report",
      "!**/dist-widget"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended", "suspicious": { "noConsole": "off" } }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
