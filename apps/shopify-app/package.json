{
  "name": "@aiart/shopify-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx node_modules/@react-router/dev/bin.js dev",
    "dev:shopify": "node scripts/dev-shopify.mjs",
    "build": "node --import tsx node_modules/@react-router/dev/bin.js build",
    "start": "react-router-serve build/server/index.js",
    "typecheck": "node --import tsx node_modules/@react-router/dev/bin.js typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aiart/contracts": "workspace:*",
    "@react-router/node": "7.18.3",
    "@react-router/serve": "7.18.3",
    "@shopify/shopify-app-react-router": "2.1.0",
    "@shopify/shopify-app-session-storage-drizzle": "5.0.1",
    "drizzle-orm": "0.45.2",
    "isbot": "5.2.2",
    "postgres": "3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@aiart/core": "workspace:*",
    "@react-router/dev": "7.18.3",
    "@shopify/cli": "^4.8.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "vite": "7.3.6"
  }
}
