# Copy to .env (`pnpm bootstrap` does this for you if .env is missing).
# Every value below works as-is for local development.

NODE_ENV=development
LOG_LEVEL=info

# --- Database (docker-compose `postgres`, host port 5433) ---
DATABASE_URL=postgres://aiart:aiart@localhost:5433/aiart
DATABASE_URL_TEST=postgres://aiart:aiart@localhost:5433/aiart_test

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0
# Keeps dev, test and e2e queues apart on the same Redis
QUEUE_PREFIX=aiart-dev

# --- S3-compatible storage (docker-compose `storage`) ---
S3_ENDPOINT=http://localhost:9000
# Endpoint used when signing browser-facing URLs. Differs from S3_ENDPOINT when
# the API reaches storage on an internal hostname.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aiart-dev
S3_ACCESS_KEY_ID=aiartadmin
S3_SECRET_ACCESS_KEY=aiartadmin-secret
S3_FORCE_PATH_STYLE=true

# --- API and worker ---
API_PORT=4000
# Public base URL of the API. Providers call {API_PUBLIC_URL}/webhooks/ai/{provider}.
# Needs a tunnel or real host once real providers are used.
API_PUBLIC_URL=http://localhost:4000
# Public https address AI providers (fal, BFL) send results to. Empty means API_PUBLIC_URL.
# `pnpm shopify:sync-env` sets it to the dev tunnel; in production it is your app's domain.
WEBHOOK_PUBLIC_URL=
WORKER_HEALTH_PORT=4001
# Header carrying the shopper's IP when requests come through the Shopify app proxy
CLIENT_IP_HEADER=x-forwarded-for

# --- Shopify ---
# Local values are placeholders; real ones come from the Partner dashboard (see docs/GO-LIVE.md).
SHOPIFY_API_KEY=dev-api-key
SHOPIFY_API_SECRET=dev-shopify-secret-change-me
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_orders
# Shop used by the mock admin login, the seed data and the storefront harness
DEV_SHOP_DOMAIN=dev-store.myshopify.com

# --- Admin panel ---
# mock = local login without Shopify; shopify = real embedded app auth
AUTH_MODE=mock
ADMIN_PORT=3000
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me

# --- Storefront harness ---
HARNESS_PORT=5173

# --- Mock AI provider ---
MOCK_PROVIDER_DELAY_MS=1500
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret-change-me

# --- Real AI providers. Add a key and restart the API and worker; the admin's Models screen and
# the design editor dropdowns then offer that provider's models (catalog: packages/contracts/src/models.ts).
# OPENAI_API_KEY: GPT Image 2 / 2.5.  GEMINI_API_KEY: Nano Banana 2 / Pro.
# BFL_API_KEY: FLUX.2 and Kontext (BFL_WEBHOOK_SECRET optional).  FAL_KEY: Seedream, Qwen, Ideogram, Recraft and more.
FAL_KEY=
BFL_API_KEY=
BFL_WEBHOOK_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
